# Copy to .env and set THREE DIFFERENT strong passwords before starting.
DB_PASSWORD=replace-with-a-unique-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-unique-login-password-12chars
# Leave AI in local practice mode, or configure your own API key later.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional server-side speech, transcription, lesson generation and AI feedback.
AI_TTS_MODEL=tts-1
AI_ASR_MODEL=whisper-1
AI_TTS_VOICE=alloy
AI_BASE_URL=https://api.openai.com
DB_SSL_MODE=DISABLED
