# Fill on the server. Do not put credentials into the image.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=speakflow
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Existing MariaDB server was explicitly approved for non-TLS use.
DB_SSL_MODE=DISABLED
SPRING_FLYWAY_LOCATIONS=classpath:db/migration-mariadb
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
AI_PROVIDER=local
# Enable this after putting the application behind HTTPS:
# SERVER_SERVLET_SESSION_COOKIE_SECURE=true
