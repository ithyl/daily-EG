# systemd EnvironmentFile: values only; do not add "export".
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=speakflow
DB_USERNAME=CHANGE_ME
DB_PASSWORD="CHANGE_ME"
# REQUIRED for TLS; DISABLED only for your explicitly approved non-TLS server.
DB_SSL_MODE=REQUIRED
# Existing MariaDB database MUST keep this migration location.
SPRING_FLYWAY_LOCATIONS=classpath:db/migration-mariadb
# For a new MySQL 8 database use classpath:db/migration instead.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD="CHANGE_ME_AT_LEAST_12_CHARACTERS"
AI_PROVIDER=local
# After configuring HTTPS, uncomment:
# SERVER_SERVLET_SESSION_COOKIE_SECURE=true
